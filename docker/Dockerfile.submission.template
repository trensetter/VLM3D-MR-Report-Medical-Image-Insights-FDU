# The exact submission image used an internal prebuilt med-swift/vLLM runtime.
# Supply an authorized, compatible base image when building; this template does
# not embed private registry addresses or model weights.
ARG MRRATE_BASE_IMAGE
FROM ${MRRATE_BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_OFFLINE=1 \
    FORITHMUS_WEIGHTS_DIR=/weights \
    MRRATE_MODEL_TYPE=qwen3_5 \
    MRRATE_TEMPLATE_TYPE=med-Qwen3-5-multi-channel-wl \
    MRRATE_ATTN_IMPL=sdpa \
    MRRATE_TORCH_DTYPE=bfloat16 \
    MRRATE_MAX_NEW_TOKENS=2048 \
    MRRATE_TEMPERATURE=0 \
    MRRATE_INFER_BATCH_SIZE=4 \
    MRRATE_PREPROCESS_WORKERS=4 \
    MRRATE_VLLM_USE_ASYNC_ENGINE=1 \
    MRRATE_VLLM_GPU_MEMORY_UTILIZATION=0.9 \
    MRRATE_VLLM_MAX_MODEL_LEN=49152 \
    MRRATE_VLLM_MAX_NUM_SEQS=4 \
    MRRATE_VLLM_MM_PROCESSOR_CACHE_GB=0 \
    MRRATE_VLLM_ATTENTION_BACKEND=FLASH_ATTN \
    MRRATE_VLLM_GDN_PREFILL_BACKEND=triton \
    XYZ_SIZE=256 \
    ZSIZE=256 \
    FPS_MAX_FRAMES=64 \
    VIDEO_MAX_TOKEN_NUM=38400 \
    IMAGE_MAX_TOKEN_NUM=51200 \
    FLA_TILELANG=0

WORKDIR /opt/app
COPY src/ /opt/app/src/
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh && \
    (id -u appuser >/dev/null 2>&1 || useradd -m -u 10001 appuser) && \
    mkdir -p /tmp/mrrate_work && \
    chown -R appuser:appuser /opt/app /tmp/mrrate_work

USER appuser
ENTRYPOINT ["/entrypoint.sh"]
